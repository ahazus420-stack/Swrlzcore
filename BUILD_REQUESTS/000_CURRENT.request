# BUILD REQUEST: 000_CURRENT.request
# Purpose: Control SWRLZ CLIENT, SERVER, Keyboard, and sCore Launcher APK build lanes.
# Workflows resolve the newest versioned ZIP and matching SHA-256 inside each lane.

request_version=2
build_variant=debug
targets=universal
commit_release_artifacts=false

# Existing application lanes
build_client=false
client_source_lane=SOURCES/CLIENT

build_server=false
server_source_lane=SOURCES/SERVER

# Independent SWRLZ Board Keyboard lane
build_keyboard=false
keyboard_source_lane=SOURCES/SWRLZ-BOARD
keyboard_source_pattern=KEYBOARD_CFv*_SWRLZ.zip

# Independent sCore Launcher lane
build_score_launcher=false
score_launcher_source_lane=SOURCES/SCORE-LAUNCHER
score_launcher_source_pattern=SCORE_LAUNCHER_CFv*_SWRLZ.zip

# Usage
# 1. Place one current source ZIP and its matching .sha256 file in the selected lane.
# 2. Keep superseded source sets in that lane's OLD_PATCHES directory.
# 3. Set only the intended build flag(s) to true.
# 4. Run the corresponding GitHub Actions workflow manually.
#
# This request does not authorize a build by itself and does not commit release artifacts
# unless commit_release_artifacts=true is explicitly set.
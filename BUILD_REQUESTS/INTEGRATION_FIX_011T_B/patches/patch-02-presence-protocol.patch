+    private fun resolveDevice(
+        body: JSONObject,
+        request: DiscoveryHttpRequest,
+        registry: PresenceRegistry,
+        proofBindings: DeviceProofBindingStore,
+        requestSecurity: PresenceRequestSecurity,
+        serverInstallationId: String,
+        requestId: String,
+    ): DiscoveryHttpResponse {
+        val input = resolutionInput(body)
+        val result = registry.resolveDevice(input)
+        return when (result.status) {
+            PresenceDeviceResolutionStatus.UNKNOWN -> resolutionSuccess(
+                requestId = requestId,
+                registryRevision = result.registryRevision,
+                resolution = "UNKNOWN",
+                device = null,
+                membershipCount = 0,
+                lineage = null,
+            )
+
+            PresenceDeviceResolutionStatus.IDENTITY_CONFLICT -> error(
+                409,
+                "IDENTITY_CONFLICT",
+                "Submitted identity evidence conflicts with an existing device record",
+                requestId,
+            )
+
+            PresenceDeviceResolutionStatus.RETIRED -> resolutionSuccess(
+                requestId = requestId,
+                registryRevision = result.registryRevision,
+                resolution = "RETIRED",
+                device = minimalDeviceJson(result.device),
+                membershipCount = 0,
+                lineage = lineageJson(result.successorDeviceId),
+            )
+
+            PresenceDeviceResolutionStatus.REPLACED -> resolutionSuccess(
+                requestId = requestId,
+                registryRevision = result.registryRevision,
+                resolution = "REPLACED",
+                device = minimalDeviceJson(result.device),
+                membershipCount = 0,
+                lineage = lineageJson(result.successorDeviceId),
+            )
+
+            PresenceDeviceResolutionStatus.BLOCKED -> resolutionSuccess(
+                requestId = requestId,
+                registryRevision = result.registryRevision,
+                resolution = "BLOCKED",
+                device = minimalDeviceJson(result.device),
+                membershipCount = 0,
+                lineage = lineageJson(result.successorDeviceId),
+            )
+
+            PresenceDeviceResolutionStatus.ACTIVE -> resolveActiveDevice(
+                request = request,
+                result = result,
+                proofBindings = proofBindings,
+                requestSecurity = requestSecurity,
+                serverInstallationId = serverInstallationId,
+                requestId = requestId,
+            )
+        }
+    }
+
+    private fun resolveActiveDevice(
+        request: DiscoveryHttpRequest,
+        result: PresenceDeviceResolution,
+        proofBindings: DeviceProofBindingStore,
+        requestSecurity: PresenceRequestSecurity,
+        serverInstallationId: String,
+        requestId: String,
+    ): DiscoveryHttpResponse {
+        val device = result.device
+            ?: throw ProtocolFailure(503, "INTERNAL_ERROR", "Resolved device state is incomplete", true)
+        val binding = proofBindings.lookup(serverInstallationId, device.deviceId)
+        return when (binding.state) {
+            DeviceProofBindingState.ENROLLMENT_REQUIRED -> resolutionActionRequired(
+                requestId = requestId,
+                registryRevision = result.registryRevision,
+                deviceId = device.deviceId,
+                code = "PROOF_ENROLLMENT_REQUIRED",
+                message = "This known device requires explicit proof-key enrollment",
+            )
+
+            DeviceProofBindingState.REVOKED -> error(
+                403,
+                binding.errorCode ?: "PROOF_KEY_REVOKED",
+                "Device proof binding is revoked",
+                requestId,
+            )
+
+            DeviceProofBindingState.UNAVAILABLE -> error(
+                503,
+                binding.errorCode ?: "PROOF_KEY_UNAVAILABLE",
+                "Device proof binding is unavailable",
+                requestId,
+                true,
+            )
+
+            DeviceProofBindingState.CONFLICT -> error(
+                409,
+                binding.errorCode ?: "PROOF_BINDING_CONFLICT",
+                "Device proof binding is conflicted",
+                requestId,
+            )
+
+            DeviceProofBindingState.BOUND -> {
+                val proofKey = binding.proofKey
+                    ?: throw ProtocolFailure(503, "PROOF_KEY_UNAVAILABLE", "Device proof key is unavailable", true)
+                try {
+                    requestSecurity.verifyKnownDeviceProof(
+                        request = request,
+                        deviceId = device.deviceId,
+                        proofKey = proofKey,
+                        protocolVersion = PROTOCOL_VERSION,
+                        schemaVersion = SCHEMA_VERSION,
+                        requestId = requestId,
+                    )
+                } finally {
+                    proofKey.fill(0)
+                }
+                resolutionSuccess(
+                    requestId = requestId,
+                    registryRevision = result.registryRevision,
+                    resolution = "KNOWN",
+                    device = deviceJson(device),
+                    membershipCount = result.membershipCount,
+                    lineage = lineageJson(result.successorDeviceId),
+                    proofBindingState = DeviceProofBindingState.BOUND.wireName,
+                )
+            }
+        }
+    }

++    private fun isApprovedLocalPeer(remote: InetAddress?, local: InetAddress?): Boolean {
++        if (remote !is Inet4Address || local !is Inet4Address) return false
++        if (remote.isLoopbackAddress || local.isLoopbackAddress) return false
++        if (!(remote.isSiteLocalAddress || remote.isLinkLocalAddress)) return false
++        if (!(local.isSiteLocalAddress || local.isLinkLocalAddress)) return false
++        val networkInterface = runCatching { NetworkInterface.getByInetAddress(local) }.getOrNull() ?: return false
++        val prefixLength = networkInterface.interfaceAddresses
++            .firstOrNull { it.address == local }
++            ?.networkPrefixLength
++            ?.toInt()
++            ?: return false
++        if (prefixLength !in 1..32) return false
++        return sameIpv4Prefix(remote.address, local.address, prefixLength)
++    }
++
++    private fun sameIpv4Prefix(left: ByteArray, right: ByteArray, prefixLength: Int): Boolean {
++        if (left.size != 4 || right.size != 4) return false
++        var remaining = prefixLength
++        for (index in left.indices) {
++            if (remaining <= 0) return true
++            val bits = minOf(8, remaining)
++            val mask = (0xFF shl (8 - bits)) and 0xFF
++            if ((left[index].toInt() and mask) != (right[index].toInt() and mask)) return false
++            remaining -= bits
++        }
++        return true
++    }

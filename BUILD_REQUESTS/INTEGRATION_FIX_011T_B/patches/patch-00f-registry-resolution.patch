+    /** Non-mutating exact-device resolution used by paired bootstrap. */
+    @Synchronized
+    fun resolveDevice(input: DeviceResolutionInput): PresenceDeviceResolution {
+        requireAvailable()
+        val exact = state.devices.firstOrNull { it.deviceId == input.deviceId }
+        if (exact == null) {
+            val correlated = state.devices.firstOrNull { candidate ->
+                listOf(
+                    input.deviceUuid to candidate.deviceUuid,
+                    input.deviceAnchor to candidate.deviceAnchor,
+                    input.fingerprintHash to candidate.fingerprintHash,
+                    input.profileMergeKey to candidate.profileMergeKey,
+                ).any { (submitted, stored) ->
+                    !submitted.isNullOrBlank() && !stored.isNullOrBlank() && submitted == stored
+                }
+            }
+            return PresenceDeviceResolution(
+                status = if (correlated == null) {
+                    PresenceDeviceResolutionStatus.UNKNOWN
+                } else {
+                    PresenceDeviceResolutionStatus.IDENTITY_CONFLICT
+                },
+                registryRevision = state.revision,
+                device = null,
+                membershipCount = 0,
+                successorDeviceId = correlated?.successorDeviceId,
+            )
+        }
+
+        val submittedConflict = listOf(
+            input.deviceUuid to exact.deviceUuid,
+            input.deviceAnchor to exact.deviceAnchor,
+            input.fingerprintHash to exact.fingerprintHash,
+            input.profileMergeKey to exact.profileMergeKey,
+        ).any { (submitted, stored) ->
+            !submitted.isNullOrBlank() && !stored.isNullOrBlank() && submitted != stored
+        }
+        if (submittedConflict) {
+            return PresenceDeviceResolution(
+                status = PresenceDeviceResolutionStatus.IDENTITY_CONFLICT,
+                registryRevision = state.revision,
+                device = null,
+                membershipCount = 0,
+                successorDeviceId = exact.successorDeviceId,
+            )
+        }
+
+        val status = when {
+            exact.lifecycleState == BLOCKED -> PresenceDeviceResolutionStatus.BLOCKED
+            exact.lifecycleState == RETIRED && !exact.successorDeviceId.isNullOrBlank() -> PresenceDeviceResolutionStatus.REPLACED
+            exact.lifecycleState == RETIRED -> PresenceDeviceResolutionStatus.RETIRED
+            exact.lifecycleState == ACTIVE -> PresenceDeviceResolutionStatus.ACTIVE
+            else -> PresenceDeviceResolutionStatus.IDENTITY_CONFLICT
+        }
+        val memberships = state.memberships.count {
+            it.deviceId == exact.deviceId && it.membershipState == ACTIVE
+        }
+        return PresenceDeviceResolution(
+            status = status,
+            registryRevision = state.revision,
+            device = exact.toView(isDeviceOnline(exact.deviceId)),
+            membershipCount = memberships,
+            successorDeviceId = exact.successorDeviceId,
+        )
+    }
